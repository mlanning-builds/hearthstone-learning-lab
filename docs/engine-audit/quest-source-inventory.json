    "END_017": {
      "progress": "ordered full-hand then empty-hand stages",
      "reward": "draw to hand limit; opponent hand removal semantics"
    },
    "TLC_229": {
      "progress": "unique minion types from paid play; multi-type and ALL matching",
      "reward": "two Adapt choices retained for future played minions"
    },
    "TLC_460": {
      "progress": "Discover completion event, not offer construction",
      "reward": "Origin Stone automatic play of unchosen options and durability, including nested choices"
    },
    "TLC_602": {
      "progress": "survived-turn boundary and when played turn counts",
      "reward": "two distinct historical Quest rewards in hand, rest in deck; all nine rewards and dependencies"
    },
    "TLC_631": {
      "progress": "exact actual two-damage events on owner turn",
      "reward": "persistent two-damage follow-up with recursion suppression and source attribution"
    },
    "TLC_817": {
      "progress": "independent Holy and Shadow goals active together",
      "reward": "physical hand combination; copied Battlecry and Deathrattle, Reborn"
    },
    "TLC_830": {
      "progress": "unique played Beast Attack values 1/3/5/7, stat snapshot timing",
      "reward": "three complete sequential Beast Discover pools at Attack 8/6/4; costs set to 2"
    },
